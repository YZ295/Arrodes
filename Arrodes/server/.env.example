PORT=3002
NODE_ENV=development
DB_PATH=./data

# DeepSeek — 注册获取: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi / Moonshot — 注册获取: https://platform.moonshot.cn
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 智谱 GLM — 注册获取: https://open.bigmodel.cn
GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 当前激活的模型
ACTIVE_MODEL=deepseek-v4-flash

# Token 额度上限（管控成本）：单日 / 单月消耗上限，超限后 LLM 调用被拒绝
TOKEN_DAILY_LIMIT=500000
TOKEN_MONTHLY_LIMIT=12000000

# 服务端语音识别（Electron 壳内浏览器 STT 不可用，录音上传此处识别）
# SiliconFlow 硅基流动 SenseVoiceSmall：https://cloud.siliconflow.cn 注册获取免费额度
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# 可选：共享 .env 路径（如 Hermes 的 .env），用于复用 API Keys；不设置则跳过
# HERMES_ENV_PATH=E:\AI\Hermes\Hermes Agent CN Desktop\data\hermes-home\.env
