PORT=3002
NODE_ENV=development
DB_PATH=./data

# 仅由 Electron 每次启动时生成并传递；不要写入仓库或长期 .env。
# ARRODES_LOCAL_TOKEN=
# ARRODES_UI_ORIGIN=http://localhost:3002

# DeepSeek — 注册获取: https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Kimi / Moonshot — 注册获取: https://platform.moonshot.cn
KIMI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
KIMI_BASE_URL=https://api.moonshot.cn/v1

# 智谱 GLM — 注册获取: https://open.bigmodel.cn
GLM_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 当前激活的模型
ACTIVE_MODEL=deepseek-v4-flash

# 视觉提供商（与聊天 ACTIVE_MODEL 独立）：magevl | deepseek | ollama
# 桌面版默认使用本地 Mage-VL，并在生产模式自动维护 sidecar 生命周期。
VISION_PROVIDER=magevl
# DeepSeek / Ollama 可选模型覆盖；Mage-VL 使用侧车的 MAGEVL_MODEL。
# VISION_MODEL=deepseek-v4-flash-vision-exp
# OLLAMA_BASE_URL=http://localhost:11434
MAGEVL_SIDECAR_URL=http://127.0.0.1:12002
MAGEVL_AUTO_START=on
# MAGEVL_PYTHON=E:\AI\magevl-env\Scripts\python.exe
# 以下是 Python 侧车进程变量，不会因写入 server/.env 自动传给单独启动的侧车。
# 请在运行 start-magevl.ps1 的 PowerShell 中设置 $env:变量名；详见 ../vision-sidecar/README.md。
# MAGEVL_MODEL=microsoft/Mage-VL
# MAGEVL_QUANT=4bit
# MAGEVL_PORT=12002

# Token 额度上限（管控成本）：单日 / 单月消耗上限，超限后 LLM 调用被拒绝
TOKEN_DAILY_LIMIT=500000
TOKEN_MONTHLY_LIMIT=12000000

# 服务端语音识别（Electron 壳内浏览器 STT 不可用，录音上传此处识别）
# SiliconFlow 硅基流动 SenseVoiceSmall：https://cloud.siliconflow.cn 注册获取免费额度
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn

# 可选：共享 .env 路径（如 Hermes 的 .env），用于复用 API Keys；不设置则跳过
# HERMES_ENV_PATH=E:\AI\Hermes\Hermes Agent CN Desktop\data\hermes-home\.env

# 本地 TTS 默认使用 Fun-CosyVoice3；仓库内标准路径与 12003 端口无需配置。
# COSYVOICE3_PYTHON=D:\Anaconda\envs\cosyvoice3\python.exe
# COSYVOICE3_MODEL_DIR=E:\project\Crow5\Arrodes\Arrodes\tts-sidecar\CosyVoice-unzip\cosyvoice-main\pretrained_models\Fun-CosyVoice3-0.5B-2512
# COSYVOICE3_SIDECAR_URL=http://127.0.0.1:12003
# 可选轻量 provider：
# AUDIO8_TTS_BASE_URL=http://127.0.0.1:12004/v1
# AUDIO8_TTS_MODEL=audio8/tts-0.1b
# 默认不发送屏幕摘要与可见文字到云端；显式设为 on 才启用 DeepSeek 增强。
VISION_ENRICHMENT=off
